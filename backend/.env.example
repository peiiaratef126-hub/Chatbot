# Backend Environment Variables
ENVIRONMENT=development
HOST=0.0.0.0
PORT=7860
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Groq Cloud API (Free Tier: 300 tokens/sec)
# If left empty, backend runs in zero-cost MOCK_MODE
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Qdrant Cloud Cluster (Free 1GB Cluster)
# If left empty, backend falls back to high-speed in-memory vector search
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=customer_support_kb

# Retrieval Parameters
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
SCORE_THRESHOLD=0.65
TOP_K=4
MOCK_MODE=false
MAX_REACT_ITERATIONS=2

# Sentry Monitoring & Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
