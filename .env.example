# ==============================================================================
# Customer Support RAG Chatbot - Global Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=7860
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Groq Cloud API (Free Tier: 300 tokens/sec)
# Get a free API key at https://console.groq.com/keys
# If left empty, backend automatically runs in zero-cost MOCK_MODE with simulated streaming
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Qdrant Cloud Vector Database (Free Tier 1GB Cluster)
# Register and create a cluster at https://cloud.qdrant.io
# If left empty, backend automatically falls back to an in-memory cosine similarity search
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=customer_support_kb

# Retrieval Parameters
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
SCORE_THRESHOLD=0.65
TOP_K=4
MAX_REACT_ITERATIONS=2

# Explicit Mock Mode Override (true = force mock streaming without API calls)
MOCK_MODE=false

# Full-Stack Sentry Telemetry & Error Tracking
# Backend DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Frontend Configuration & Telemetry
# Points to FastAPI backend (localhost for development, HF Space for production)
NEXT_PUBLIC_API_URL=http://localhost:7860
NEXT_PUBLIC_SENTRY_DSN=
