# ==============================================================================
# Customer Support RAG Chatbot - Environment Configuration
# ==============================================================================

# Backend Service Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=7860
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Groq Cloud API (Free Tier: 300 tokens/sec)
# Get a free key at https://console.groq.com/keys
# If left empty, backend automatically runs in MOCK_MODE with zero-cost simulated tool calls
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Qdrant Cloud Vector Database (Free Tier 1GB Cluster)
# Register at https://cloud.qdrant.io
# If left empty, backend automatically falls back to an in-memory cosine similarity search
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=customer_support_kb

# Embeddings Configuration
# Default lightweight model supported locally or in Colab: BAAI/bge-small-en-v1.5 or all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
SCORE_THRESHOLD=0.65
TOP_K=4

# Explicit Mock Mode Override (set to true to test without external APIs)
MOCK_MODE=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:7860
